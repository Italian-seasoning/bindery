---
import Base from '../layouts/Base.astro';
import Readout from '../components/Readout.astro';
import Footer from '../components/Footer.astro';
import Bind from '../components/home/Bind.astro';
import Ticker from '../components/home/Ticker.astro';
import Verbs from '../components/home/Verbs.astro';
import { facts, withBase } from '../data/site';
---
<Base>
  <Bind />
  <Ticker />
  <Verbs />

  <section class="facts" aria-labelledby="facts-title">
    <h2 id="facts-title" class="sr-only">What you can count on</h2>
    <ul>
      {facts.map((f) => (
        <li class="fact" data-reveal="up"><p class="fact__big">{f.big}</p><p class="fact__small">{f.small}</p></li>
      ))}
    </ul>
  </section>

  <section class="invite" aria-labelledby="invite-title">
    <Readout face="look-left" label="" class="invite__face" data-agent="look" data-gaze />
    <div class="invite__copy">
      <h2 id="invite-title" class="invite__title">Want the long version?</h2>
      <p class="invite__lede">One agent tells how its skills ended up in three folders, and how a library brought them back.</p>
      <a class="sweep" href={withBase('/story/')}><span>Read the story</span></a>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
